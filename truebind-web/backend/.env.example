# TrueBind backend configuration. Copy to backend/.env for local development
# (read by the API, the worker, worker child processes and Alembic alike).
# Real environment variables override this file; in production the file is
# NOT read -- set variables in the host (Render) instead. Never commit .env.
# Every setting is listed; commented lines show the default. Secrets are
# always empty here. Source of truth: app/settings.py.

# ---------------------------------------------------------------- runtime
# development | test | production. Production enforces PostgreSQL, a strong
# SECRET_KEY, secure cookies, no self sign-up by default, no /docs.
# TRUEBIND_ENV=development
# TRUEBIND_DATA_DIR=data
# One database for everything. Relative SQLite paths resolve against backend/.
DATABASE_URL=sqlite:///data/truebind-mvp.db
# PostgreSQL instead; use a NON-superuser role so Row Level Security applies:
# DATABASE_URL=postgresql+psycopg://truebind:dev@localhost:5432/truebind
# Secret: >= 32 random characters in production (encrypts 2FA and SSO secrets).
SECRET_KEY=
# PUBLIC_APP_URL=http://localhost:3000
# PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------- HTTP / sessions
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# COOKIE_SECURE=           (default: on in production, off otherwise)
# SESSION_TTL_HOURS=12
# ALLOW_SIGNUP=            (default: off in production, on otherwise)
# LOGIN_LOCKOUT_THRESHOLD=5
# LOGIN_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------- uploads
# MAX_UPLOAD_MB=50
# MAX_UNCOMPRESSED_MB=800
# MAX_COMPRESSION_RATIO=150
# MAX_SHEETS=200
# MAX_ROWS=1000000
# MAX_CELLS=60000000

# ---------------------------------------------------------------- storage
# db (PostgreSQL; the production default, durable on hosts whose disk is wiped on restart)
# | local (files under TRUEBIND_STORAGE_DIR; the development default) | s3 (AWS S3, Cloudflare R2, MinIO)
# STORAGE_BACKEND=
# TRUEBIND_STORAGE_DIR=     (default: <TRUEBIND_DATA_DIR>/objects)
# S3_BUCKET=
# S3_ENDPOINT_URL=          (empty for AWS; R2: https://<account>.r2.cloudflarestorage.com)
# S3_REGION=eu-west-2
# S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_SSE=AES256             (AES256 | aws:kms | none)

# ---------------------------------------------------------------- jobs / workers
# Development: the API process also runs the worker loop. Production: run
# `python -m app.worker` as separate processes.
TRUEBIND_EMBEDDED_WORKER=1
# JOB_TIMEOUT_S=600
# JOB_MEMORY_MB=4096
# JOB_LEASE_S=60
# JOB_MAX_ATTEMPTS=2
# MAX_CONCURRENT_JOBS_PER_TENANT=3
# WORKER_STALE_S=20
# Optional: Redis for job wake-ups and shared rate limits (EU region).
# REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- AI-assisted mapping
# AI_MAX_CALLS_PER_REPORT=50
# AI_TIME_BUDGET_S=30
# Engine command-line tool only (bordereaux/). The web app never calls Anthropic directly:
# it uses AI_PROVIDER (EU/UK hosting) below.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- outbound e-mail
# Empty SMTP_HOST = e-mail delivery shows "not configured"; nothing is sent.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
SMTP_PASSWORD=
# SMTP_FROM=truebind@localhost
# SMTP_STARTTLS=true
# MAX_EMAIL_ATTACHMENT_MB=10

# ---------------------------------------------------------------- observability
# LOG_LEVEL=INFO
# LOG_JSON=                 (default: on in production)
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0

# ---------------------------------------------------------------- 2FA
# TOTP_ISSUER=TrueBind

# ---- AI provider (P2). EU/UK hosting only; only column headers and a few masked
# sample values are sent; suggestions are never applied without user confirmation.
# AI_PROVIDER=none                  (none | azure_openai | bedrock; "fake" is for tests)
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_REGION=              (must be EU/UK, e.g. swedencentral, uksouth, westeurope)
# BEDROCK_REGION=eu-central-1       (must start with eu-; uses the standard AWS credential chain)
# BEDROCK_MODEL_ID=

# ---- Inbound e-mail (P2): <org inbound token>@INBOUND_EMAIL_DOMAIN
# INBOUND_EMAIL_DOMAIN=inbound.example.com
INBOUND_WEBHOOK_SECRET=
# SES_SNS_TOPIC_ARNS=               (comma-separated SNS topics allowed to post SES mail)

# ---- Outbound webhooks (P2)
# WEBHOOK_MAX_ATTEMPTS=6
# WEBHOOK_ALLOW_PRIVATE_TARGETS=false   (true only for local testing)

# ---- FX reference rates (P2, ECB)
# FX_AUTO_REFRESH=false
# ECB_RATES_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-hist-90d.xml

# ---- Billing (P9). Off by default: nothing is limited. When on, plans come from
# BILLING_PLANS (JSON) and prices from Stripe. Keys from the Stripe dashboard (use
# test-mode keys until go-live); never commit real values.
BILLING_ENABLED=false
# BILLING_PLANS={"essentials":{"label":"Essentials","price_id":"price_...","modules":["binder"],"monthly_rows":50000,"seats":5}}
BILLING_PLANS={}
BILLING_DEFAULT_PLAN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com
