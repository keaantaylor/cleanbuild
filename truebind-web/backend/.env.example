# Copy to backend/.env for local development. Read by the API, the worker,
# worker child processes and Alembic alike, so they always share one database.
# Real environment variables override these values. Never commit backend/.env.

# One database for everything. Relative SQLite paths resolve against backend/.
DATABASE_URL=sqlite:///data/truebind-mvp.db
# PostgreSQL instead (as in docker-compose); use a NON-superuser role so Row
# Level Security applies:
# DATABASE_URL=postgresql+psycopg://truebind:dev@localhost:5432/truebind

# Run the job worker inside the API process (development default: on).
# Set to 0 only if you start `python -m app.worker` yourself.
TRUEBIND_EMBEDDED_WORKER=1

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: enables AI-assisted mapping of headers the alias rules miss.
# ANTHROPIC_API_KEY=
