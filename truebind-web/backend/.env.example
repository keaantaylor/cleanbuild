# Postgres in production/docker-compose; omit for SQLite local dev
# (defaults to sqlite:///./data/truebind.db)
DATABASE_URL=postgresql+psycopg://truebind:dev@localhost:5432/truebind

CORS_ORIGINS=http://localhost:3000

# Optional -- AI-assisted column mapping fallback degrades gracefully
# without it, same as the Streamlit build.
ANTHROPIC_API_KEY=
